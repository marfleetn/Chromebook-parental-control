{
  "manifest_version": 3,
  "name": "CHPC Family",
  "version": "0.1.0",
  "description": "Self-hosted parental controls for family Chromebooks. Policy lives on the parent's console; this extension applies it.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "CHPC Family" },
  "permissions": ["storage", "declarativeNetRequest", "webRequest", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["pages/blocked.html"], "matches": ["http://*/*", "https://*/*"] }
  ]
}
