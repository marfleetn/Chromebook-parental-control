# CHPC — environment (copy to .env and adjust). Read by docker-compose.yml;
# for bare-Node runs export these in your shell or service file.

# Guardian PIN. Normally you leave this EMPTY: on first run the server prints a
# one-time setup code and you choose the PIN in the console. Set it here only if
# you prefer a fixed PIN managed in config (6+ characters, not repeated/sequential).
CHPC_GUARDIAN_PIN=

# Server
PORT=4100
# Bare Node: 127.0.0.1 = this machine only; 0.0.0.0 = whole LAN. Docker always binds 0.0.0.0.
HOST=127.0.0.1
# Developers only: skip the PIN entirely. Honoured on loopback addresses only.
# CHPC_ALLOW_NO_PIN=1

# Storage. In the container this is /data/chpc.db (volume); bare metal uses ./data/chpc.db.
# CHPC_DB=/opt/chpc/data/chpc.db
# CHPC_PUBLIC_DIR=/opt/chpc/web/dist

# Delete usage rows older than this many days (0 = keep forever).
CHPC_RETENTION_DAYS=90

# Behind a TLS reverse proxy (Caddy/nginx)? Set to 1 so rate limits see real client IPs.
# CHPC_TRUST_PROXY=1

# Rarely needed: origins allowed to call the API cross-origin, comma-separated.
# CHPC_CORS_ORIGINS=https://console.example.home
